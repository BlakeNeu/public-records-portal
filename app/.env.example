# Copy to app/.env and fill in. Never commit .env.
# These values are for local development only.

# Only for `npm run dev` on your machine; Docker Compose sets its own.
# Matches the Compose defaults (or your root .env, if you made one).
DATABASE_URL="postgresql://prrp:local-dev-password@localhost:5432/records_portal?schema=public"

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(33).toString('base64url'))"
AUTH_SECRET=""

# The portal's public origin. Set explicitly so Auth.js never trusts the
# request's Host header (in AWS this is the load balancer's HTTPS URL).
AUTH_URL="http://localhost:3000"

# Proxies in front of the portal that append to X-Forwarded-For (default 1,
# the load balancer). Rate limits and audit rows trust only those entries.
# TRUSTED_PROXY_HOPS=1

# Password given to every seeded demo account (see prisma/seed.ts).
SEED_PASSWORD="demo-password-local-only"
