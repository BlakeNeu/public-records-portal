# Copy to .env and fill in. Never commit .env.
# These values are for local development only.

POSTGRES_USER=prrp
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=records_portal

# Shared secret the portal sends to the integration service (min 32 chars).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_TOKEN=

# Mock upstream behavior: fraction of requests that fail with 503 (exercises retries)
MOCK_FAILURE_RATE=0.2
