# Optional. Docker Compose has a local-only default for every value below.
# Copy to .env only to override them. Never commit .env.

POSTGRES_USER=prrp
# Use only letters, digits, - and _ so it can sit in a connection URL.
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=records_portal

# Signs portal session cookies (32+ characters). Generate one with:  npx auth secret
AUTH_SECRET=

# Shared secret the portal sends to the integration service (min 32 chars).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_TOKEN=

# Password for every seeded demo account. Applies when the database is first created.
SEED_PASSWORD=demo-password-local-only

# Host ports, in case 3000 or 5432 is already in use on your machine.
WEB_PORT=3000
POSTGRES_PORT=5432

# Mock upstream behavior: fraction of requests that fail with 503 (exercises retries)
MOCK_FAILURE_RATE=0.2
